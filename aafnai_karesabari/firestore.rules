rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(field) { return signedIn() && request.auth.uid == field; }
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /users/{userId} {
      allow read, create: if owns(userId) || isAdmin();
      allow update: if (owns(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'sellerStatus', 'activeRole'])) || isAdmin();
      allow list, delete: if isAdmin();
    }
    match /seller_applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid;
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isAdmin());
      allow update, delete, list: if isAdmin();
    }
    match /otp_verifications/{verificationId} {
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow get, update: if signedIn() && resource.data.owner_uid == request.auth.uid;
      allow list, delete: if false;
    }
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.farmer_id == request.auth.uid;
      allow update, delete: if owns(resource.data.farmer_id);
    }
    match /orders/{orderId} {
      allow read: if signedIn() && (owns(resource.data.farmer_id) || owns(resource.data.consumer_id));
      allow write: if signedIn();
    }
    match /sellerListings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if owns(resource.data.sellerId);
    }
    match /reviews/{reviewId} { allow read: if true; allow write: if signedIn(); }
    match /price_history/{priceId} { allow read: if true; allow write: if false; }
    match /notifications/{notificationId} { allow read: if owns(resource.data.user_id); allow write: if signedIn(); }
  }
}
